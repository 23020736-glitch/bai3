<?xml version="1.0"?>
<!-- Gripper song song 2 ngon (prismatic), gan vao tool0. Dieu khien luc qua gazebo_ros2_control.
     Hinh hoc (tinh tu tool0, z huong xuong): de 0.004-0.042, ngon 0.0435-0.1055, tam khoi khi gap 0.09 (= tcp_offset). -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:macro name="ur3_gripper" params="parent">
    <material name="gripper_dark"><color rgba="0.12 0.12 0.12 1.0"/></material>
    <material name="gripper_grey"><color rgba="0.65 0.65 0.68 1.0"/></material>

    <link name="gripper_base_link">
      <visual><origin xyz="0 0 0.019"/><geometry><box size="0.04 0.14 0.038"/></geometry><material name="gripper_dark"/></visual>
      <collision><origin xyz="0 0 0.019"/><geometry><box size="0.04 0.14 0.038"/></geometry></collision>
      <inertial><mass value="0.25"/><origin xyz="0 0 0.019"/>
        <inertia ixx="0.0004" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0005"/></inertial>
    </link>
    <joint name="gripper_mount_joint" type="fixed">
      <parent link="${parent}"/><child link="gripper_base_link"/><origin xyz="0 0 0.004" rpy="0 0 0"/>
    </joint>

    <link name="finger_left_link">
      <visual><geometry><box size="0.02 0.012 0.062"/></geometry><material name="gripper_grey"/></visual>
      <collision><geometry><box size="0.02 0.012 0.062"/></geometry></collision>
      <inertial><mass value="0.03"/>
        <inertia ixx="0.00001" ixy="0" ixz="0" iyy="0.00001" iyz="0" izz="0.000002"/></inertial>
    </link>
    <joint name="finger_left_joint" type="prismatic">
      <parent link="gripper_base_link"/><child link="finger_left_link"/>
      <origin xyz="0 0.045 0.0705" rpy="0 0 0"/><axis xyz="0 -1 0"/>
      <limit lower="0" upper="0.035" effort="100" velocity="0.2"/>
      <dynamics damping="20.0" friction="0.0"/>
    </joint>

    <link name="finger_right_link">
      <visual><geometry><box size="0.02 0.012 0.062"/></geometry><material name="gripper_grey"/></visual>
      <collision><geometry><box size="0.02 0.012 0.062"/></geometry></collision>
      <inertial><mass value="0.03"/>
        <inertia ixx="0.00001" ixy="0" ixz="0" iyy="0.00001" iyz="0" izz="0.000002"/></inertial>
    </link>
    <joint name="finger_right_joint" type="prismatic">
      <parent link="gripper_base_link"/><child link="finger_right_link"/>
      <origin xyz="0 -0.045 0.0705" rpy="0 0 0"/><axis xyz="0 1 0"/>
      <limit lower="0" upper="0.035" effort="100" velocity="0.2"/>
      <dynamics damping="20.0" friction="0.0"/>
    </joint>

    <!-- ma sat cao + tiep xuc cung de kep chat khoi -->
    <gazebo reference="finger_left_link">
      <mu1>2.0</mu1><mu2>2.0</mu2><kp>1000000.0</kp><kd>100.0</kd><minDepth>0.0005</minDepth><maxVel>0.1</maxVel>
    </gazebo>
    <gazebo reference="finger_right_link">
      <mu1>2.0</mu1><mu2>2.0</mu2><kp>1000000.0</kp><kd>100.0</kd><minDepth>0.0005</minDepth><maxVel>0.1</maxVel>
    </gazebo>

    <ros2_control name="GripperSystem" type="system">
      <hardware><plugin>gazebo_ros2_control/GazeboSystem</plugin></hardware>
      <joint name="finger_left_joint">
        <command_interface name="effort"/>
        <state_interface name="position"/><state_interface name="velocity"/>
      </joint>
      <joint name="finger_right_joint">
        <command_interface name="effort"/>
        <state_interface name="position"/><state_interface name="velocity"/>
      </joint>
    </ros2_control>
  </xacro:macro>
</robot>
